{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/services",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5000
        }
      ],
      "UpstreamPathTemplate": "/gateway/services",
      "UpstreamHttpMethod": [ "GET" ],
      "SwaggerKey": "services"
    }
  ],
  "SwaggerEndPoints": [
    {
      "Key": "services",
      "Config": [
        {
          "Name": "Services API v1",
          "Version": "v1",
          "Url": "https://localhost:5000/swagger/swagger.json"
        }
      ]
    }


  ]
}
